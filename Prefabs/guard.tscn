[sub_resource type="GDScript" id="GDScript_hc525"]
script/source = "extends CharacterBody2D

# Guard states: PATROL - LOOK AROUND - CHASE
enum State { PATROL, LOOK_AROUND, CHASE }
var current_state: State = State.PATROL

# Empty list to type coordinates for the guard's walking path
@export var patrol_points : Array[Vector2] = []

# Patrol and chase speeds
@export var movement_speed : float = 50.0
@export var chase_speed : float = 120.0

@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D
@onready var vision_cone: Area2D = $VisionCone
@onready var raycast: RayCast2D = $RayCast2D

var target_point_index: int = 0
var look_timer:  float = 0.0
var player_ref: CharacterBody2D = null
var current_direction: String = \"down\"

func _ready() -> void:
	# Connect the VisionCone area signals to track when objects overlap his eyes
	vision_cone.body_entered.connect(_on_vision_cone_body_entered)
	vision_cone.body_exited.connect(_on_vision_cone_body_exited)
	sprite.play(\"idle_down\")
	
	# Automatically find the player node via their group tag at launch
	player_ref = get_tree().get_first_node_in_group(\"Player\")

func _physics_process(delta: float) -> void:
	# Continuously monitor vision and noise circles every physics tick
	check_for_player_detection()

	match current_state:
		State.PATROL:
			handle_patrol(delta)
		State.LOOK_AROUND:
			handle_look_around(delta)
		State.CHASE:
			handle_chase(delta)
			
	move_and_slide()
	update_animation()

# --- DETECTION COGNITION ---

func check_for_player_detection() -> void:
	if not player_ref or current_state == State.CHASE:
		return
		
	# 1. Standard Line-of-Sight Check (Is the player's physical body inside the vision cone directly?)
	if vision_cone.overlaps_body(player_ref) and can_see_player():
		current_state = State.CHASE
		return
		
	# 2. Vision Cone Noise Intersection Check
	# Check if the player's expanding noise circle is entering our guard's vision cone triangle
	var noise_node = player_ref.get_node_or_null(\"Noise/CollisionShape2D\")
	if noise_node and noise_node.shape is CircleShape2D:
		var noise_radius = noise_node.shape.radius
		var distance_to_player = global_position.distance_to(player_ref.global_position)
		
		# If the physical edge of the player's noise circle spans far enough to overlap the guard...
		if distance_to_player <= noise_radius:
			# ...AND the guard is currently looking in the player's direction (using our VisionCone check)
			if is_player_in_guard_fov() and can_see_player():
				current_state = State.CHASE

# --- STATE MANAGEMENT ---

func handle_patrol(_delta: float) -> void:
	if patrol_points.is_empty():
		return
	
	var target = patrol_points[target_point_index]
	var direction = (target - global_position).normalized()
	
	velocity = direction * movement_speed
	update_direction_string(direction)
	
	# Rotate the vision triangle to point in the exact direction the guard walks
	vision_cone.rotation = direction.angle() - PI/2
	
	if global_position.distance_to(target) < 5.0:
		velocity = Vector2.ZERO
		current_state = State.LOOK_AROUND
		look_timer = 2.0 

func handle_look_around(delta: float) -> void:
	look_timer -= delta
	
	if look_timer <= 0.0:
		target_point_index = (target_point_index + 1) % patrol_points.size()
		current_state = State.PATROL
	else:
		vision_cone.rotation += sin(Time.get_ticks_msec() * 0.005) * 0.01

func handle_chase(_delta: float) -> void:
	# Keep chasing as long as player is visible OR making enough noise within field of view
	if player_ref and (can_see_player() or (is_player_audible() and is_player_in_guard_fov())):
		var direction = (player_ref.global_position - global_position).normalized()
		velocity = direction * chase_speed
		vision_cone.rotation = direction.angle() - PI/2
		update_direction_string(direction)
	else:
		current_state = State.PATROL

# --- SIGHT & GEOMETRY VERIFICATION ---

func can_see_player() -> bool:
	if not player_ref:
		return false
	
	raycast.target_position = raycast.to_local(player_ref.global_position)
	raycast.force_raycast_update()
	
	if not raycast.is_colliding() or raycast.get_collider() == player_ref:
		return true
	
	return false

func is_player_in_guard_fov() -> bool:
	# Mathematical check to see if the angle to the player falls inside the direction the vision cone is looking
	var direction_to_player = (player_ref.global_position - global_position).angle()
	# Align the angles since the vision cone is offset by -PI/2
	var guard_facing_angle = vision_cone.rotation + PI/2
	
	var angle_difference = abs(angle_difference(guard_facing_angle, direction_to_player))
	
	# If the angle to the player is less than 45 degrees (0.785 rads) from where the guard faces, it's inside his FOV cone
	return angle_difference < 0.785

func is_player_audible() -> bool:
	if not player_ref:
		return false
	var noise_node = player_ref.get_node_or_null(\"Noise/CollisionShape2D\")
	if noise_node and noise_node.shape is CircleShape2D:
		return global_position.distance_to(player_ref.global_position) <= noise_node.shape.radius
	return false

# --- SIGNAL DETECTORS ---

func _on_vision_cone_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"Player\"):
		pass # Logic handled dynamically inside check_for_player_detection framework now

func _on_vision_cone_body_exited(body: Node2D) -> void:
	pass

# --- DIRECTIONAL LOOKUP & ANIMATION ---

func update_direction_string(input: Vector2) -> void:
	if abs(input.x) > abs(input.y):
		current_direction = \"right\" if input.x > 0 else \"left\"
	else:
		current_direction = \"down\" if input.y > 0 else \"up\"

func update_animation() -> void:
	if velocity == Vector2.ZERO:
		sprite.play(\"idle_\" + current_direction)
	else:
		sprite.play(\"walk_\" + current_direction)
"

